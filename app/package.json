{
  "name": "vibewright",
  "version": "0.2.1",
  "description": "Vibewright – You vibe. It builds. Aus einer Idee wird eine Laufkarte, umgesetzt mit Claude Code.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/claude-finden.js && node test/ablage.js && node test/archiv.js && node test/e2e.js",
    "exe": "electron-builder --win nsis",
    "notices": "node build/hinweise-bauen.js",
    "exe:mac": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "productName": "Vibewright",
  "build": {
    "appId": "de.vibewright.app",
    "productName": "Vibewright",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!build/icon-bauen.js",
      "!dist/**",
      "!build/hinweise-bauen.js",
      "!build/installer-bilder.js",
      "!build/*.bmp",
      "!build/*-vorschau.png",
      "!build/installer.nsh"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "extraFiles": [
        "THIRD_PARTY_NOTICES.md",
        {
          "from": "LICENSE",
          "to": "LICENSE.vibewright.txt"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Vibewright",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "license": "build/license.txt",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "de_DE",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "include": "build/installer.nsh"
    },
    "npmRebuild": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "Vibewright-${version}-mac-${arch}.${ext}",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [
        "THIRD_PARTY_NOTICES.md",
        {
          "from": "LICENSE",
          "to": "LICENSE.vibewright.txt"
        }
      ]
    },
    "dmg": {
      "title": "Vibewright ${version}"
    },
    "afterPack": "build/adhoc-signieren.js"
  },
  "license": "MIT",
  "author": "neodk2004",
  "homepage": "https://github.com/neodk2004"
}
